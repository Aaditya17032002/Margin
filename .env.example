# ============================================================================
# Margin — Environment Variables
# Copy to .env and fill in real values for production.
# ============================================================================

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=Margin
APP_ENV=dev                          # dev | staging | prod
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost
LOG_LEVEL=DEBUG                      # DEBUG | INFO | WARNING | ERROR

# ── Auth / JWT ───────────────────────────────────────────────────────────
SECRET_KEY=CHANGE-ME-in-production-use-openssl-rand-hex-64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Microsoft OAuth (MSAL) ──────────────────────────────────────────────
# Leave empty for mock/dev mode
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=
MS_REDIRECT_URI=http://localhost:8000/api/v1/auth/microsoft/callback

# ── Database (Postgres + pgvector) ───────────────────────────────────────
DB_HOST=db                           # 'db' in Docker, 'localhost' outside
DB_PORT=5432
DB_USER=margin
DB_PASSWORD=margin
DB_NAME=margin

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=redis                     # 'redis' in Docker, 'localhost' outside
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Provider Mode ────────────────────────────────────────────────────────
PROVIDER_MODE=mock                   # mock | azure

# ── Azure OpenAI — Sweden Central (chat + embeddings) ───────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR-SWEDEN.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o                    # orchestration / cheap fields
AZURE_OPENAI_DEPLOYMENT_EXTRACT=gpt-5.2           # in-document specialist agents
AZURE_OPENAI_DEPLOYMENT_VERIFIER=gpt-5.2          # citation critic / verifier
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_KEY=                          # optional; falls back to AZURE_OPENAI_API_KEY

# ── Azure Deep Research — Norway East (o3-deep-research) ────────────────
AZURE_DEEP_RESEARCH_ENDPOINT=https://YOUR-NORWAY.openai.azure.com/
AZURE_DEEP_RESEARCH_API_KEY=
AZURE_DEEP_RESEARCH_DEPLOYMENT=o3-deep-research
AZURE_DEEP_RESEARCH_REGION=norwayeast
AZURE_DEEP_RESEARCH_API_VERSION=2025-01-01-preview

AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=

# ── Embedding ────────────────────────────────────────────────────────────
EMBEDDING_DIM=1536

# ── Reports ──────────────────────────────────────────────────────────────
REPORTS_DIR=/srv/reports
UPLOADS_DIR=/srv/uploads
MAX_UPLOAD_BYTES=67108864

# ── Rate Limits ──────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_RUN=10/minute
RATE_LIMIT_EXPORT=10/minute

# ── Observability ────────────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
